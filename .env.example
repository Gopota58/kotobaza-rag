# ==========================================================================
#  Копируйте этот файл в .env и заполните своими значениями.
#  Большинство параметров имеют разумные значения по умолчанию.
# ==========================================================================

# --- API ---
# Ключ доступа к эндпоинтам. ОБЯЗАТЕЛЬНО смените в продакшене!
API_KEY=88888888

# --- LLM (OpenAI-совместимый endpoint) ---
# Вариант A (рекомендуется): локально через LM Studio / llama.cpp — бесплатно и офлайн
LLM_PROVIDER=local
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=your-local-model-name

# Вариант B: облачный OpenAI — раскомментируйте и заполните,
#             а LLM_BASE_URL оставьте пустым.
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_API_KEY=sk-your-real-key
# LLM_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.4
LLM_TOP_P=0.9
LLM_MAX_TOKENS=512
# Некоторые маленькие локальные модели (напр. ornith) не поддерживают system-роль.
# Поставьте false, чтобы инструкция переносилась в пользовательское сообщение.
LLM_USE_SYSTEM_PROMPT=true
# Защита от переполнения контекстного окна (символы), передаваемого в LLM.
LLM_MAX_CONTEXT_CHARS=4000
# Доп. параметры API в виде JSON (напр. для отключения reasoning у Qwen3 в LM Studio:
# {"chat_template_kwargs": {"enable_thinking": false}}). Пусто — по умолчанию.
LLM_EXTRA_BODY={}

# --- ВАЖНО: выбирайте НЕ-reasoning модель (Qwen2.5-Instruct, Llama-3-Instruct и т.п.).
# Reasoning-модели (Qwen3-thinking) часто отдают пустой content — ответ будет пустым.
# В LM Studio отключите «Thinking» при загрузке модели, либо используйте instruct-вариант.

# --- Эмбеддинги (обычно менять не нужно) ---
# EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# --- CORS (через запятую; * — разрешить все, НЕ использовать с куками) ---
ALLOWED_ORIGINS=*

# --- Провайдер эмбеддингов ---
# local — локальный all-MiniLM-L6-v2 (офлайн, но слаб по-русски; требует
#         pip install sentence-transformers torch).
# api   — OpenAI-совместимый endpoint (LM Studio / Ollama), напр. nomic-embed-text
#         — заметно лучше понимает русский. Рекомендуется.
EMBED_PROVIDER=api
EMBED_API_MODEL=text-embedding-nomic-embed-text-v1.5
# EMBED_API_BASE_URL=            # пусто -> берётся LLM_BASE_URL
# EMBED_API_KEY=lm-studio

# --- Telegram-бот (нужен только для bot.py) ---
# Токен от @BotFather. В коде токенов нет — без значения бот не запустится.
TELEGRAM_BOT_TOKEN=123456789:REPLACE-WITH-YOUR-BOTFATHER-TOKEN
# HTTP-прокси для обхода блокировки api.telegram.org в РФ. Пусто = прямое соединение.
TELEGRAM_PROXY=http://127.0.0.1:7890
# Адрес веб-сервера, к которому бот ходит за ответами (POST /ask).
RAG_API_URL=http://localhost:8000
